{
  "name": "allergy-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Helps travelers with food allergies understand menus and confirm with restaurant staff. Does not judge food safety.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-offline-worker.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:offline-browser": "node tests/e2e/browser/offline.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.0",
    "@google/genai": "2.30.0",
    "google-gax": "6.16.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@google-cloud/firestore-api": {
      "google-gax": "5.0.4"
    }
  }
}
